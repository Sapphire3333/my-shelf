#!/bin/sh
# Stamps version.js with today's date (plus a counter for a second commit on
# the same day) so every build carries its own name. The app shows the stamp,
# and the service worker's cache is named after it — which is what guarantees
# a new build can never be served from an old cache.
#
# It also refuses a commit that would leave an ALREADY SHIPPED build with no
# line in WHATS_NEW. Today's card on the shelf is the only place a build ever
# announces itself; three builds once went out with nothing written for any of
# them, and from the outside that is indistinguishable from the app not having
# changed. See the note above unseenNews in index.html.
#
# This hook only runs if git is told where to find it (once per machine):
#   git config core.hooksPath .githooks

# Builds are DATE.N: the date sorts as text, the run number as a number.
newer_of() { printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1 -k2,2n | tail -1; }

# The date is UTC's, on every machine. It was each machine's own: a commit on
# a computer in Riga just after midnight was stamped with the new day, and a
# cloud container's commit two hours later, running on UTC, with the old one
# -- an OLDER name for a newer build, so phones never offered it.
d=$(date -u +%Y-%m-%d)
n=1
cur=""
if [ -f version.js ]; then
  cur=$(sed -n 's/.*APP_VERSION = "\([^"]*\)".*/\1/p' version.js)
fi
# And the stamp follows the newest build known here, not only this checkout's:
# a branch cut from main before a cloud build landed counted from the older
# number and gave the next build a name main had already shipped -- the same
# worker address, so no browser installed it. origin/main is read as last
# fetched; nothing here goes to the network.
base="$cur"
remote=$(git show origin/main:version.js 2>/dev/null | sed -n 's/.*APP_VERSION = "\([^"]*\)".*/\1/p')
if [ -n "$remote" ]; then
  if [ -z "$base" ]; then base="$remote"; else base=$(newer_of "$base" "$remote"); fi
fi
# never older than what came before, whatever the clock says
if [ -n "$base" ]; then
  bd=${base%.*}; bn=${base##*.}
  if [ "$bd" = "$d" ]; then n=$(( bn + 1 ))
  elif [ "$(printf '%s\n%s\n' "$bd" "$d" | sort | tail -1)" = "$bd" ]; then d="$bd"; n=$(( bn + 1 ))
  fi
fi
# PRINT_STAMP=1 sh .githooks/pre-commit prints the stamp this commit would
# get, for the What's new line, and changes nothing.
if [ -n "$PRINT_STAMP" ]; then echo "$d.$n"; exit 0; fi

# The newest entry in WHATS_NEW — the array is newest-first, so it is the first
# v:"…" after the opening bracket.
news=""
if [ -f index.html ]; then
  news=$(sed -n '/const WHATS_NEW=\[/,$p' index.html \
    | grep -o 'v:"[0-9][0-9-]*\.[0-9][0-9]*"' | head -1 | sed 's/^v:"//;s/"$//')
fi

if [ -n "$news" ] && [ -n "$cur" ] && [ "$(newer_of "$news" "$cur")" != "$news" ]; then
  echo "pre-commit: build $cur has already shipped and WHATS_NEW stops at $news." >&2
  echo "  Today's What's new card is the only place a build announces itself," >&2
  echo "  and it shows nothing for a build with no entry. Add one at the top of" >&2
  echo "  WHATS_NEW in index.html, or commit with SKIP_NEWS=1 to say it needs none." >&2
  [ -n "$SKIP_NEWS" ] || exit 1
fi

if [ -n "$news" ] && [ "$(newer_of "$news" "$d.$n")" != "$news" ]; then
  echo "pre-commit: note — this commit becomes $d.$n and WHATS_NEW stops at $news." >&2
fi

# Two mistakes that pass every test and only show up later. Both are read off
# the STAGED index.html, before the build is stamped.
#
# A raw NUL byte makes search tools take the file for binary: a folder-wide
# ripgrep stopped at the first one, and every function below it — a third of
# the app — answered "no matches". In a string it is written "\u0000".
#
# One tag with two class attributes: the parser keeps the first and silently
# drops the second, so a state class (`off`, `cold`) never applies. Two did
# exactly that, unseen, for months.
if git cat-file -e :index.html 2>/dev/null; then
  all=$(git show :index.html | wc -c)
  nonul=$(git show :index.html | tr -d '\000' | wc -c)
  if [ "$all" -ne "$nonul" ]; then
    echo "pre-commit: index.html holds $((all - nonul)) raw NUL byte(s). Write it as \"\\u0000\" inside" >&2
    echo "  the string — a raw one makes search tools skip the rest of the file." >&2
    exit 1
  fi
  dup=$(git show :index.html | grep -naoE '<[a-zA-Z][a-zA-Z0-9]*[[:space:]][^<>]*\bclass="[^"]*"[^<>]*\bclass=' | head -3)
  if [ -n "$dup" ]; then
    echo "pre-commit: a tag in index.html has two class attributes, and the browser ignores the second." >&2
    echo "  Put both in one class list. Line:" >&2
    echo "$dup" | cut -c1-160 >&2
    exit 1
  fi
fi

cat > version.js <<EOF
/* Build stamp — written by .githooks/pre-commit at every commit; do not edit.
   The app shows it (Overview → Storage), and the offline cache is named after
   it, so a new build can never be served from an old cache. */
window.APP_VERSION = "$d.$n";
EOF

git add version.js
